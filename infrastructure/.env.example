# =============================================================================
# PDL-145T Infrastructure - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env files to version control.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=pdl145t
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
POSTGRES_DB=pdl145t

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# --- Backend ---
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
PORT=8002

# --- Frontend ---
VITE_API_URL=http://localhost:8002

# --- Domain (for production SSL) ---
DOMAIN=localhost
