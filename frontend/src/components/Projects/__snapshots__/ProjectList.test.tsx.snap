// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ProjectList > matches snapshot 1`] = `
<div
  class="card card--outlined card--padding-md "
>
  <div
    class="card-header "
  >
    <h3
      class="card-header__title"
