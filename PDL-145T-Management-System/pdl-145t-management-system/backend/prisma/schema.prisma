// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Projects Table - Manages the overall projects
model Project {
  ProjectID      Int      @id @default(autoincrement())
  Name           String
  StartDate      DateTime
  EndDate        DateTime?
  TotalBudget    Decimal
  CreatedAt      DateTime @default(now())
  UpdatedAt      DateTime @updatedAt

  // Relationships
  ProjectResources ProjectResource[]
  Tasks           Task[]
  Reports         Report[]
  Sprints         Sprint[]
}

// Tasks Table - Manages individual tasks within a project
model Task {
  TaskID         Int      @id @default(autoincrement())
  ProjectID      Int
  SprintID       Int?
  Description    String?
  Duration       Int?
  AssignedTo     String?
  CompletionStatus TaskCompletionStatus @default(NotStarted)
  progressPercentage Int @default(0)
  actualCost     Decimal? @default(0)
  estimatedCost  Decimal? @default(0)
  statusReason   String?
  CreatedAt      DateTime @default(now())
  UpdatedAt      DateTime @updatedAt

  // Relationships
  Project       Project   @relation(fields: [ProjectID], references: [ProjectID])
  Sprint        Sprint?   @relation(fields: [SprintID], references: [SprintID])
  Expenses      Expense[]
  TaskResources TaskResource[]
  Measurements  Measurement[]
  Validations   Validation[]
}

// Expenses Table - Tracks expenses associated with tasks or projects
model Expense {
  ExpenseID    Int      @id @default(autoincrement())
  TaskID       Int
  Description  String?
  Cost         Decimal
  Date         DateTime
  CreatedAt    DateTime @default(now())
  UpdatedAt    DateTime @updatedAt

  // Relationships
  Task Task @relation(fields: [TaskID], references: [TaskID])
  ApprovalWorkflow ApprovalWorkflow?
  ExpenseHistory ExpenseHistory[]
  ReconciliationAudits ReconciliationAudit[]
}

// Resources Table - Stores information about available resources
model Resource {
  ResourceID   Int      @id @default(autoincrement())
  Type         String
  Quantity     Decimal
  CreatedAt    DateTime @default(now())
  UpdatedAt    DateTime @updatedAt

  // Relationships
  ProjectResources ProjectResource[]
  TaskResources TaskResource[]
}

// Project Resources - Many-to-Many relationship between Projects and Resources
model ProjectResource {
  ProjectID  Int
  ResourceID Int

  // Relationships
  Project  Project  @relation(fields: [ProjectID], references: [ProjectID])
  Resource Resource @relation(fields: [ResourceID], references: [ResourceID])

  @@id([ProjectID, ResourceID])
}

// Task Resources - Many-to-Many relationship between Tasks and Resources
model TaskResource {
  TaskID     Int
  ResourceID Int

  // Relationships
  Task     Task     @relation(fields: [TaskID], references: [TaskID])
  Resource Resource @relation(fields: [ResourceID], references: [ResourceID])

  @@id([TaskID, ResourceID])
}

// Measurements Table - Records site measurements performed by the Construction Execution Agent
model Measurement {
  MeasurementID Int      @id @default(autoincrement())
  TaskID      Int
  SiteID      String
  MeasurementType String
  Value       Decimal
  Date        DateTime
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  // Relationships
  Task Task @relation(fields: [TaskID], references: [TaskID])
  Site Site @relation(fields: [SiteID], references: [SiteID])
}

// Validations Table - Tracks validations of construction sites
model Validation {
  ValidationID Int      @id @default(autoincrement())
  TaskID       Int
  SiteID       String
  Status       ValidationStatus @default(Pending)
  Notes        String?
  GeneratedBy  String
  Timestamp    DateTime @default(now())
  UpdatedAt    DateTime @updatedAt

  // Relationships
  Task Task @relation(fields: [TaskID], references: [TaskID])
  Site Site @relation(fields: [SiteID], references: [SiteID])
  Reports Report[]
}

// Reports Table - Holds reports generated for billing validation
model Report {
  ReportID    Int      @id @default(autoincrement())
  ValidationID Int
  ProjectID   Int
  GeneratedBy String
  Timestamp   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  // Relationships
  Validation Validation @relation(fields: [ValidationID], references: [ValidationID])
  Project    Project    @relation(fields: [ProjectID], references: [ProjectID])
}

// Territory Table - Manages territories containing multiple sites
model Territory {
  TerritoryID Int    @id @default(autoincrement())
  Name        String @unique
  Sites       Site[]
}

// Site Table - Manages construction sites within territories
model Site {
  SiteID      String @id      // keep string for compatibility with Measurement/Validation
  Name        String
  Type        SiteType
  Province    String
  TerritoryID Int
  Location    String? // Coordinates as string (lat,lng)
  Elevation   Float?
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  Territory   Territory @relation(fields: [TerritoryID], references: [TerritoryID])
  Measurements Measurement[]
  Validations  Validation[]
}

// User Table - Stores user authentication and profile information
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships for audit trail
  auditLogs    AuditLog[]
  expenseHistories ExpenseHistory[]
  reconciliationAudits ReconciliationAudit[]
  
  // Relationships for approval workflow
  level1Approvals ApprovalWorkflow[] @relation("level1Approver")
  level2Approvals ApprovalWorkflow[] @relation("level2Approver")
  level3Approvals ApprovalWorkflow[] @relation("level3Approver")
  level4Approvals ApprovalWorkflow[] @relation("level4Approver")
}

// Sprint Table - Manages agile sprints within projects
model Sprint {
  SprintID    Int          @id @default(autoincrement())
  ProjectID   Int
  Name        String
  StartDate   DateTime
  EndDate     DateTime
  Status      SprintStatus @default(PLANNED)
  CreatedAt   DateTime     @default(now())
  UpdatedAt   DateTime     @updatedAt

  // Relationships
  Project Project @relation(fields: [ProjectID], references: [ProjectID])
  Tasks   Task[]
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskCompletionStatus {
  NotStarted
  InProgress
  Completed
}

enum ValidationStatus {
  Pending
  Approved
  Rejected
}

enum SiteType {
  CENTRE_DE_SANTE
  ECOLE_PRIMAIRE
  BATIMENT_ADMINISTRATIF
}

enum UserRole {
  USER
  ADMIN
  SUPERVISOR
  FINANCE
  CONSTRUCTION
}

enum ApprovalStatus {
  Pending
  Approved
  Rejected
}

enum ApprovalLevel {
  LEVEL_1_RL
  LEVEL_2_RC
  LEVEL_3_CQ
  LEVEL_4_CFEF
}

enum ReconciliationStatus {
  Matched
  Discrepancy
  Pending
  Resolved
}

// ============================================
// AUDIT & APPROVAL MODELS
// ============================================

// AuditLog - Complete audit trail of all operations
model AuditLog {
  id            Int      @id @default(autoincrement())
  entityType    String   // "Expense", "Approval", etc.
  entityId      Int
  action        String   // "CREATE", "UPDATE", "DELETE", "APPROVE", "REJECT"
  userId        Int
  timestamp     DateTime @default(now())
  changes       Json?    // JSON of what changed
  reason        String?  // Justification for the action
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
  
  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
}

// ExpenseHistory - Track modifications to expenses
model ExpenseHistory {
  id            Int      @id @default(autoincrement())
  expenseId     Int
  fieldName     String   // Which field changed
  oldValue      String?  // Previous value
  newValue      String?  // New value
  changedBy     Int
  changedAt     DateTime @default(now())

  user          User     @relation(fields: [changedBy], references: [id])
  expense       Expense  @relation(fields: [expenseId], references: [ExpenseID], onDelete: Cascade)

  @@index([expenseId])
  @@index([changedBy])
  @@index([changedAt])
}

// ApprovalWorkflow - 4-level approval workflow for expenses
model ApprovalWorkflow {
  id                Int      @id @default(autoincrement())
  expenseId         Int      @unique
  currentLevel      ApprovalLevel @default(LEVEL_1_RL)
  
  // Level 1 - Responsable Logistique (RL)
  level1_approver   Int?
  level1_status     ApprovalStatus @default(Pending)
  level1_date       DateTime?
  level1_notes      String?
  
  // Level 2 - Responsable Comptable (RC)
  level2_approver   Int?
  level2_status     ApprovalStatus @default(Pending)
  level2_date       DateTime?
  level2_notes      String?
  
  // Level 3 - Coordinateur Qualité (CQ)
  level3_approver   Int?
  level3_status     ApprovalStatus @default(Pending)
  level3_date       DateTime?
  level3_notes      String?
  
  // Level 4 - CFEF Commission (Final approval)
  level4_approver   Int?
  level4_status     ApprovalStatus @default(Pending)
  level4_date       DateTime?
  level4_notes      String?
  
  paymentBlockedUntil DateTime?
  createdAt         DateTime @default(now())
  completedAt       DateTime?
  updatedAt         DateTime @updatedAt
  
  expense           Expense  @relation(fields: [expenseId], references: [ExpenseID], onDelete: Cascade)
  
  level1User        User?    @relation("level1Approver", fields: [level1_approver], references: [id])
  level2User        User?    @relation("level2Approver", fields: [level2_approver], references: [id])
  level3User        User?    @relation("level3Approver", fields: [level3_approver], references: [id])
  level4User        User?    @relation("level4Approver", fields: [level4_approver], references: [id])

  @@index([expenseId])
  @@index([currentLevel])
  @@index([level1_status])
  @@index([level4_status])
}

// ReconciliationAudit - Track reconciliation of invoices vs purchase orders
model ReconciliationAudit {
  id                     Int      @id @default(autoincrement())
  expenseId              Int
  invoiceId              String
  purchaseOrderId        String?
  
  status                 ReconciliationStatus @default(Pending)
  discrepancyReason      String?  // Why there's a discrepancy
  
  auditedBy              Int      // CQ user ID
  auditDate              DateTime @default(now())
  resolutionDate         DateTime?
  resolutionNotes        String?
  
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  
  expense                Expense  @relation(fields: [expenseId], references: [ExpenseID], onDelete: Cascade)
  auditor                User     @relation(fields: [auditedBy], references: [id])

  @@index([expenseId])
  @@index([status])
  @@index([invoiceId])
  @@index([auditDate])
}
