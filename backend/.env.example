# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/pdl_management
# Prisma direct (unpooled) connection. `prisma migrate`/`generate` require this
# because the schema sets `directUrl = env("DIRECT_URL")`. For local/dev and
# docker compose this should mirror DATABASE_URL.
DIRECT_URL=postgresql://postgres:password@localhost:5432/pdl_management

# Server Configuration
PORT=3010

# JWT Configuration (generate a secure secret in production)
JWT_SECRET=your-jwt-secret-here

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Documents physiques PDL-145T (racine des dossiers ADMIN/FINANCE/JURIDIQUE/SUIVI/TECHNIQUE)
# Doit pointer vers le workspace GME_ASCAT_SPPE contenant les fichiers classes par l'ontologie.
DOCUMENTS_ROOT=/chemin/vers/GME_ASCAT_SPPE

# Node Environment
NODE_ENV=development

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
