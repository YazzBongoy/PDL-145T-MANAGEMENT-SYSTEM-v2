generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Program {
  ProgramID   Int       @id @default(autoincrement())
  Name        String
  Description String?
  StartDate   DateTime?
  EndDate     DateTime?
  Budget      Decimal?
  Status      ProgramStatus @default(ACTIVE)
  CreatedAt   DateTime  @default(now())
  UpdatedAt   DateTime  @updatedAt
  Projects    Project[]
}

model Project {
  ProjectID        Int               @id @default(autoincrement())
  ProgramID        Int
  Name             String
  Description      String?
  StartDate        DateTime
  EndDate          DateTime?
  TotalBudget      Decimal
  CreatedAt        DateTime          @default(now())
  UpdatedAt        DateTime          @updatedAt
  ProjectResources ProjectResource[]
  Reports          Report[]
  Sprints          Sprint[]
  Tasks            Task[]
  Program          Program           @relation(fields: [ProgramID], references: [ProgramID])
}

model Task {
  TaskID             Int                  @id @default(autoincrement())
  ProjectID          Int
  ParentTaskID       Int?
  Name               String
  Description        String?
  Duration           Int?
  AssignedTo         String?
  CompletionStatus   TaskCompletionStatus @default(NotStarted)
  CreatedAt          DateTime             @default(now())
  UpdatedAt          DateTime             @updatedAt
  SprintID           Int?
  actualCost         Decimal?             @default(0)
  estimatedCost      Decimal?             @default(0)
  progressPercentage Int                  @default(0)
  statusReason       String?
  Level              Int                  @default(1) // Niveau 1, 2 ou 3
  Expenses           Expense[]
  Measurements       Measurement[]
  Project            Project              @relation(fields: [ProjectID], references: [ProjectID])
  Sprint             Sprint?              @relation(fields: [SprintID], references: [SprintID])
  TaskResources      TaskResource[]
  Validations        Validation[]
  ParentTask         Task?                @relation("TaskHierarchy", fields: [ParentTaskID], references: [TaskID])
  SubTasks           Task[]               @relation("TaskHierarchy")
}

model Expense {
  ExpenseID            Int                   @id @default(autoincrement())
  TaskID               Int
  Description          String?
  Cost                 Decimal
  Date                 DateTime
  CreatedAt            DateTime              @default(now())
  UpdatedAt            DateTime              @updatedAt
  ApprovalWorkflow     ApprovalWorkflow?
  Task                 Task                  @relation(fields: [TaskID], references: [TaskID])
  ExpenseHistory       ExpenseHistory[]
  ReconciliationAudits ReconciliationAudit[]
}

model Resource {
  ResourceID       Int               @id @default(autoincrement())
  Type             String
  Quantity         Decimal           @default(1)
  CreatedAt        DateTime          @default(now())
  UpdatedAt        DateTime          @updatedAt
  Cost             Decimal?
  Description      String?
  LastMaintenance  DateTime?
  Location         String?
  Name             String
  NextMaintenance  DateTime?
  PurchaseDate     DateTime?
  SerialNumber     String?           @unique
  Status           String            @default("active")
  ProjectResources ProjectResource[]
  TaskResources    TaskResource[]
}

model ProjectResource {
  ProjectID  Int
  ResourceID Int
  Project    Project  @relation(fields: [ProjectID], references: [ProjectID])
  Resource   Resource @relation(fields: [ResourceID], references: [ResourceID])

  @@id([ProjectID, ResourceID])
}

model TaskResource {
  TaskID            Int
  ResourceID        Int
  AllocatedQuantity Int      @default(1)
  ActualQuantity    Int?
  UsageDate         DateTime @default(now())
  Resource          Resource @relation(fields: [ResourceID], references: [ResourceID])
  Task              Task     @relation(fields: [TaskID], references: [TaskID])

  @@id([TaskID, ResourceID])
}

model Measurement {
  MeasurementID   Int      @id @default(autoincrement())
  TaskID          Int
  SiteID          String
  MeasurementType String
  Value           Decimal
  Date            DateTime
  CreatedAt       DateTime @default(now())
  UpdatedAt       DateTime @updatedAt
  Site            Site     @relation(fields: [SiteID], references: [SiteID])
  Task            Task     @relation(fields: [TaskID], references: [TaskID])
}

model Validation {
  ValidationID Int              @id @default(autoincrement())
  TaskID       Int
  SiteID       String
  Status       ValidationStatus @default(Pending)
  Notes        String?
  GeneratedBy  String
  Timestamp    DateTime         @default(now())
  UpdatedAt    DateTime         @updatedAt
  Reports      Report[]
  Site         Site             @relation(fields: [SiteID], references: [SiteID])
  Task         Task             @relation(fields: [TaskID], references: [TaskID])
}

model Report {
  ReportID     Int        @id @default(autoincrement())
  ValidationID Int
  ProjectID    Int
  GeneratedBy  String
  Timestamp    DateTime   @default(now())
  UpdatedAt    DateTime   @updatedAt
  Project      Project    @relation(fields: [ProjectID], references: [ProjectID])
  Validation   Validation @relation(fields: [ValidationID], references: [ValidationID])
}

model Territory {
  TerritoryID Int    @id @default(autoincrement())
  Name        String @unique
  Sites       Site[]
}

model Site {
  SiteID       String        @id
  Name         String
  Type         SiteType
  Province     String
  TerritoryID  Int
  Location     String?
  Elevation    Float?
  CreatedAt    DateTime      @default(now())
  UpdatedAt    DateTime      @updatedAt
  Measurements Measurement[]
  Territory    Territory     @relation(fields: [TerritoryID], references: [TerritoryID])
  Validations  Validation[]
}

model User {
  id                   Int                   @id @default(autoincrement())
  name                 String
  email                String                @unique
  passwordHash         String
  role                 UserRole              @default(USER)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  level1Approvals      ApprovalWorkflow[]    @relation("level1Approver")
  level2Approvals      ApprovalWorkflow[]    @relation("level2Approver")
  level3Approvals      ApprovalWorkflow[]    @relation("level3Approver")
  level4Approvals      ApprovalWorkflow[]    @relation("level4Approver")
  auditLogs            AuditLog[]
  expenseHistories     ExpenseHistory[]
  reconciliationAudits ReconciliationAudit[]
  settings             UserSettings?
}

model UserSettings {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  theme              String   @default("system")
  language           String   @default("en")
  dateFormat         String   @default("MM/DD/YYYY")
  notifications      Json     @default("{}")
  emailNotifications Json     @default("{}")
  pushNotifications  Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Sprint {
  SprintID  Int          @id @default(autoincrement())
  ProjectID Int
  Name      String
  StartDate DateTime
  EndDate   DateTime
  Status    SprintStatus @default(PLANNED)
  CreatedAt DateTime     @default(now())
  UpdatedAt DateTime     @updatedAt
  Project   Project      @relation(fields: [ProjectID], references: [ProjectID])
  Tasks     Task[]
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  entityType String
  entityId   Int
  action     String
  userId     Int
  timestamp  DateTime @default(now())
  changes    Json?
  reason     String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
}

model ExpenseHistory {
  id        Int      @id @default(autoincrement())
  expenseId Int
  fieldName String
  oldValue  String?
  newValue  String?
  changedBy Int
  changedAt DateTime @default(now())
  user      User     @relation(fields: [changedBy], references: [id])
  expense   Expense  @relation(fields: [expenseId], references: [ExpenseID], onDelete: Cascade)

  @@index([expenseId])
  @@index([changedBy])
  @@index([changedAt])
}

model ApprovalWorkflow {
  id                  Int            @id @default(autoincrement())
  expenseId           Int            @unique
  currentLevel        ApprovalLevel  @default(LEVEL_1_RL)
  level1_approver     Int?
  level1_status       ApprovalStatus @default(Pending)
  level1_date         DateTime?
  level1_notes        String?
  level2_approver     Int?
  level2_status       ApprovalStatus @default(Pending)
  level2_date         DateTime?
  level2_notes        String?
  level3_approver     Int?
  level3_status       ApprovalStatus @default(Pending)
  level3_date         DateTime?
  level3_notes        String?
  level4_approver     Int?
  level4_status       ApprovalStatus @default(Pending)
  level4_date         DateTime?
  level4_notes        String?
  paymentBlockedUntil DateTime?
  createdAt           DateTime       @default(now())
  completedAt         DateTime?
  updatedAt           DateTime       @updatedAt
  expense             Expense        @relation(fields: [expenseId], references: [ExpenseID], onDelete: Cascade)
  level1User          User?          @relation("level1Approver", fields: [level1_approver], references: [id])
  level2User          User?          @relation("level2Approver", fields: [level2_approver], references: [id])
  level3User          User?          @relation("level3Approver", fields: [level3_approver], references: [id])
  level4User          User?          @relation("level4Approver", fields: [level4_approver], references: [id])

  @@index([expenseId])
  @@index([currentLevel])
  @@index([level1_status])
  @@index([level4_status])
}

model ReconciliationAudit {
  id                Int                  @id @default(autoincrement())
  expenseId         Int
  invoiceId         String
  purchaseOrderId   String?
  status            ReconciliationStatus @default(Pending)
  discrepancyReason String?
  auditedBy         Int
  auditDate         DateTime             @default(now())
  resolutionDate    DateTime?
  resolutionNotes   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  auditor           User                 @relation(fields: [auditedBy], references: [id])
  expense           Expense              @relation(fields: [expenseId], references: [ExpenseID], onDelete: Cascade)

  @@index([expenseId])
  @@index([status])
  @@index([invoiceId])
  @@index([auditDate])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum ProgramStatus {
  ACTIVE
  SUSPENDED
  COMPLETED
  CANCELLED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskCompletionStatus {
  NotStarted
  InProgress
  Completed
}

enum ValidationStatus {
  Pending
  Approved
  Rejected
}

enum SiteType {
  CENTRE_DE_SANTE
  ECOLE_PRIMAIRE
  BATIMENT_ADMINISTRATIF
}

enum UserRole {
  USER
  ADMIN
  SUPERVISOR
  FINANCE
  CONSTRUCTION
}

enum ApprovalStatus {
  Pending
  Approved
  Rejected
}

enum ApprovalLevel {
  LEVEL_1_RL
  LEVEL_2_RC
  LEVEL_3_CQ
  LEVEL_4_CFEF
}

enum ReconciliationStatus {
  Matched
  Discrepancy
  Pending
  Resolved
}
