generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Program {
  ProgramID   Int       @id @default(autoincrement())
  Name        String
  Description String?
  StartDate   DateTime?
  EndDate     DateTime?
  Budget      Decimal?
  Status      ProgramStatus @default(ACTIVE)
  CreatedAt   DateTime  @default(now())
  UpdatedAt   DateTime  @updatedAt
  Projects    Project[]
}

model Project {
  ProjectID          Int               @id @default(autoincrement())
  ProgramID          Int
  Name               String
  Description        String?
  StartDate          DateTime
  EndDate            DateTime?
  TotalBudget        Decimal
  CreatedAt          DateTime          @default(now())
  UpdatedAt          DateTime          @updatedAt
  ProjectResources   ProjectResource[]
  Reports            Report[]
  Sprints            Sprint[]
  Tasks              Task[]
  Program            Program           @relation(fields: [ProgramID], references: [ProgramID])
  Documents          Document[]
  Contracts          Contract[]
  ProjectEnterprises ProjectEnterprise[]
  ProjectSites       ProjectSite[]
}

model ProjectSite {
  ProjectID Int
  SiteID    String
  Project   Project @relation(fields: [ProjectID], references: [ProjectID], onDelete: Cascade)
  Site      Site    @relation(fields: [SiteID], references: [SiteID], onDelete: Cascade)
  @@id([ProjectID, SiteID])
}

model Task {
  TaskID             Int                  @id @default(autoincrement())
  ProjectID          Int
  SiteID             String?
  ParentTaskID       Int?
  Name               String
  Description        String?
  Duration           Int?
  AssignedTo         String?
  CompletionStatus   TaskCompletionStatus @default(NotStarted)
  CreatedAt          DateTime             @default(now())
  UpdatedAt          DateTime             @updatedAt
  SprintID           Int?
  actualCost         Decimal?             @default(0)
  estimatedCost      Decimal?             @default(0)
  progressPercentage Int                  @default(0)
  statusReason       String?
  Level              Int                  @default(1) // Niveau 1, 2 ou 3
  SortOrder          Int                  @default(0) // Ordre séquentiel dans le planning
  Weight             Decimal?             @default(0) // Poids physique (%) pour la moyenne pondérée
  ouvrageType        OuvrageType?         // Type d'ouvrage pour les tâches de construction
  Expenses           Expense[]
  Measurements       Measurement[]
  Project            Project              @relation(fields: [ProjectID], references: [ProjectID])
  Site               Site?                @relation("TaskSite", fields: [SiteID], references: [SiteID])
  Sprint             Sprint?              @relation(fields: [SprintID], references: [SprintID])
  TaskResources      TaskResource[]
  Validations        Validation[]
  ParentTask         Task?                @relation("TaskHierarchy", fields: [ParentTaskID], references: [TaskID])
  SubTasks           Task[]               @relation("TaskHierarchy")
  ConstructionSteps  ConstructionStep[]   // Étapes de construction de l'ouvrage
}

model Expense {
  ExpenseID            Int                   @id @default(autoincrement())
  TaskID               Int
  Description          String?
  Cost                 Decimal
  Date                 DateTime
  CreatedAt            DateTime              @default(now())
  UpdatedAt            DateTime              @updatedAt
  ApprovalWorkflow     ApprovalWorkflow?
  Task                 Task                  @relation(fields: [TaskID], references: [TaskID])
  ExpenseHistory       ExpenseHistory[]
  ReconciliationAudits ReconciliationAudit[]
}

enum ResourceType {
  PERSONNE
  EQUIPEMENT
  MATÉRIEL
}

model Resource {
  ResourceID       Int               @id @default(autoincrement())
  Type             ResourceType
  Quantity         Decimal           @default(1)
  Unit             String?           // Unité de la ressource (m³, m², pce, H/J, etc.)
  CreatedAt        DateTime          @default(now())
  UpdatedAt        DateTime          @updatedAt
  Cost             Decimal?          // Prix unitaire
  Description      String?
  LastMaintenance  DateTime?
  Location         String?
  Name             String
  NextMaintenance  DateTime?
  PurchaseDate     DateTime?
  SerialNumber     String?           @unique
  Status           String            @default("active")
  PurchaseType     String?           // Pour équipement: "LOUER" ou "ACHETER"
  ProjectResources ProjectResource[]
  TaskResources    TaskResource[]
  SiteResources    SiteResource[]
}

model ProjectResource {
  ProjectID  Int
  ResourceID Int
  Project    Project  @relation(fields: [ProjectID], references: [ProjectID])
  Resource   Resource @relation(fields: [ResourceID], references: [ResourceID])

  @@id([ProjectID, ResourceID])
}

model TaskResource {
  TaskID            Int
  ResourceID        Int
  AllocatedQuantity Int      @default(1)
  ActualQuantity    Int?
  UsageDate         DateTime @default(now())
  Resource          Resource @relation(fields: [ResourceID], references: [ResourceID])
  Task              Task     @relation(fields: [TaskID], references: [TaskID])

  @@id([TaskID, ResourceID])
}

model SiteResource {
  SiteID            String
  ResourceID        Int
  AllocatedQuantity Int      @default(1)
  ActualQuantity    Int?
  UsageDate         DateTime @default(now())
  Resource          Resource @relation(fields: [ResourceID], references: [ResourceID])
  Site              Site     @relation(fields: [SiteID], references: [SiteID])

  @@id([SiteID, ResourceID])
}

model Measurement {
  MeasurementID   Int      @id @default(autoincrement())
  TaskID          Int
  SiteID          String
  MeasurementType String
  Value           Decimal
  Date            DateTime
  CreatedAt       DateTime @default(now())
  UpdatedAt       DateTime @updatedAt
  Site            Site     @relation(fields: [SiteID], references: [SiteID])
  Task            Task     @relation(fields: [TaskID], references: [TaskID])
}

model Validation {
  ValidationID Int              @id @default(autoincrement())
  TaskID       Int
  SiteID       String
  Status       ValidationStatus @default(Pending)
  Notes        String?
  GeneratedBy  String
  Timestamp    DateTime         @default(now())
  UpdatedAt    DateTime         @updatedAt
  Reports      Report[]
  Site         Site             @relation(fields: [SiteID], references: [SiteID])
  Task         Task             @relation(fields: [TaskID], references: [TaskID])
}

model Report {
  ReportID     Int        @id @default(autoincrement())
  ValidationID Int
  ProjectID    Int
  GeneratedBy  String
  Timestamp    DateTime   @default(now())
  UpdatedAt    DateTime   @updatedAt
  Project      Project    @relation(fields: [ProjectID], references: [ProjectID])
  Validation   Validation @relation(fields: [ValidationID], references: [ValidationID])
}

model Territory {
  TerritoryID Int    @id @default(autoincrement())
  Name        String @unique
  Sites       Site[]
}

model Site {
  SiteID       String        @id
  Name         String
  Type         SiteType
  Province     String
  TerritoryID  Int
  Location     String?
  Elevation    Float?
  tepGlobal    Float         @default(0)
  CreatedAt    DateTime      @default(now())
  UpdatedAt    DateTime      @updatedAt
  Measurements Measurement[]
  Territory    Territory     @relation(fields: [TerritoryID], references: [TerritoryID])
  Validations  Validation[]
  ProjectSites ProjectSite[]
  Tasks        Task[]        @relation("TaskSite")
  SiteResources SiteResource[]
}

model User {
  id                   Int                   @id @default(autoincrement())
  name                 String
  email                String                @unique
  passwordHash         String
  role                 UserRole              @default(USER)
  status               UserStatus            @default(ACTIVE)
  avatar               String?
  lastLoginAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  level1Approvals      ApprovalWorkflow[]    @relation("level1Approver")
  level2Approvals      ApprovalWorkflow[]    @relation("level2Approver")
  level3Approvals      ApprovalWorkflow[]    @relation("level3Approver")
  level4Approvals      ApprovalWorkflow[]    @relation("level4Approver")
  auditLogs            AuditLog[]
  expenseHistories     ExpenseHistory[]
  reconciliationAudits ReconciliationAudit[]
  settings             UserSettings?
  activities           UserActivity[]
  notifications        Notification[]
  userPermissions      UserPermission[]
  reportTemplates      ReportTemplate[]
}

model UserSettings {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  theme              String   @default("system")
  language           String   @default("en")
  dateFormat         String   @default("MM/DD/YYYY")
  notifications      Json     @default("{}")
  emailNotifications Json     @default("{}")
  pushNotifications  Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Sprint {
  SprintID  Int          @id @default(autoincrement())
  ProjectID Int
  Name      String
  StartDate DateTime
  EndDate   DateTime
  Status    SprintStatus @default(PLANNED)
  CreatedAt DateTime     @default(now())
  UpdatedAt DateTime     @updatedAt
  Project   Project      @relation(fields: [ProjectID], references: [ProjectID])
  Tasks     Task[]
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  entityType String
  entityId   Int
  action     String
  userId     Int
  timestamp  DateTime @default(now())
  changes    Json?
  reason     String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
}

model ExpenseHistory {
  id        Int      @id @default(autoincrement())
  expenseId Int
  fieldName String
  oldValue  String?
  newValue  String?
  changedBy Int
  changedAt DateTime @default(now())
  user      User     @relation(fields: [changedBy], references: [id])
  expense   Expense  @relation(fields: [expenseId], references: [ExpenseID], onDelete: Cascade)

  @@index([expenseId])
  @@index([changedBy])
  @@index([changedAt])
}

model ApprovalWorkflow {
  id                  Int            @id @default(autoincrement())
  expenseId           Int            @unique
  currentLevel        ApprovalLevel  @default(LEVEL_1_RL)
  level1_approver     Int?
  level1_status       ApprovalStatus @default(Pending)
  level1_date         DateTime?
  level1_notes        String?
  level2_approver     Int?
  level2_status       ApprovalStatus @default(Pending)
  level2_date         DateTime?
  level2_notes        String?
  level3_approver     Int?
  level3_status       ApprovalStatus @default(Pending)
  level3_date         DateTime?
  level3_notes        String?
  level4_approver     Int?
  level4_status       ApprovalStatus @default(Pending)
  level4_date         DateTime?
  level4_notes        String?
  paymentBlockedUntil DateTime?
  createdAt           DateTime       @default(now())
  completedAt         DateTime?
  updatedAt           DateTime       @updatedAt
  expense             Expense        @relation(fields: [expenseId], references: [ExpenseID], onDelete: Cascade)
  level1User          User?          @relation("level1Approver", fields: [level1_approver], references: [id])
  level2User          User?          @relation("level2Approver", fields: [level2_approver], references: [id])
  level3User          User?          @relation("level3Approver", fields: [level3_approver], references: [id])
  level4User          User?          @relation("level4Approver", fields: [level4_approver], references: [id])

  @@index([expenseId])
  @@index([currentLevel])
  @@index([level1_status])
  @@index([level4_status])
}

model ReconciliationAudit {
  id                Int                  @id @default(autoincrement())
  expenseId         Int
  invoiceId         String
  purchaseOrderId   String?
  status            ReconciliationStatus @default(Pending)
  discrepancyReason String?
  auditedBy         Int
  auditDate         DateTime             @default(now())
  resolutionDate    DateTime?
  resolutionNotes   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  auditor           User                 @relation(fields: [auditedBy], references: [id])
  expense           Expense              @relation(fields: [expenseId], references: [ExpenseID], onDelete: Cascade)

  @@index([expenseId])
  @@index([status])
  @@index([invoiceId])
  @@index([auditDate])
}

model ConstructionStep {
  StepID          Int                 @id @default(autoincrement())
  TaskID          Int
  StepType        ConstructionStepType
  Name            String
  Description     String?
  Order           Int                 @default(0) // Ordre d'exécution
  ProgressPercent Int                 @default(0) // 0-100
  Status          StepStatus          @default(NOT_STARTED)
  StartDate       DateTime?
  EndDate         DateTime?
  ActualCost      Decimal?            @default(0)
  EstimatedCost   Decimal?            @default(0)
  CreatedAt       DateTime            @default(now())
  UpdatedAt       DateTime            @updatedAt
  Task            Task                @relation(fields: [TaskID], references: [TaskID], onDelete: Cascade)
  Photos          ConstructionPhoto[]

  @@index([TaskID])
  @@index([StepType])
  @@index([Status])
}

model ConstructionPhoto {
  PhotoID     Int              @id @default(autoincrement())
  StepID      Int
  URL         String
  Caption     String?
  TakenAt     DateTime         @default(now())
  TakenBy     String?
  Latitude    Float?
  Longitude   Float?
  CreatedAt   DateTime         @default(now())
  ConstructionStep ConstructionStep @relation(fields: [StepID], references: [StepID], onDelete: Cascade)

  @@index([StepID])
}

enum StepStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum ProgramStatus {
  ACTIVE
  SUSPENDED
  COMPLETED
  CANCELLED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskCompletionStatus {
  NotStarted
  InProgress
  Completed
}

enum ValidationStatus {
  Pending
  Approved
  Rejected
}

// Phase 2: Enterprise Management
model Enterprise {
  EnterpriseID    Int               @id @default(autoincrement())
  Name            String
  Type            EnterpriseType
  Role            EnterpriseRole
  ContactEmail    String?
  ContactPhone    String?
  Address         String?
  TaxID           String?           @unique
  CreatedAt       DateTime          @default(now())
  UpdatedAt       DateTime          @updatedAt
  Contracts       Contract[]
  ProjectEnterprises ProjectEnterprise[]
}

model ProjectEnterprise {
  ProjectID    Int
  EnterpriseID Int
  Role         EnterpriseRole
  JoinedAt     DateTime       @default(now())
  Project      Project        @relation(fields: [ProjectID], references: [ProjectID], onDelete: Cascade)
  Enterprise   Enterprise     @relation(fields: [EnterpriseID], references: [EnterpriseID], onDelete: Cascade)

  @@id([ProjectID, EnterpriseID])
  @@index([ProjectID])
  @@index([EnterpriseID])
}

// Phase 2: Contract Management
model Contract {
  ContractID       Int             @id @default(autoincrement())
  ContractNumber   String          @unique
  ProjectID        Int
  EnterpriseID     Int
  Title            String
  TotalAmount      Decimal
  StartDate        DateTime
  EndDate          DateTime?
  Status           ContractStatus  @default(DRAFT)
  AdvancePayment   Decimal?        @default(0) // Avance 30%
  RetentionRate    Decimal?        @default(5) // Retenue 5%
  PenaltyRate      Decimal?        @default(0.1) // Pénalité 1/1000
  Description      String?
  CreatedAt        DateTime        @default(now())
  UpdatedAt        DateTime        @updatedAt
  Project          Project         @relation(fields: [ProjectID], references: [ProjectID])
  Enterprise       Enterprise      @relation(fields: [EnterpriseID], references: [EnterpriseID])
  Documents        Document[]
  PaymentSchedules PaymentSchedule[]

  @@index([ProjectID])
  @@index([EnterpriseID])
  @@index([Status])
}

model PaymentSchedule {
  ScheduleID    Int             @id @default(autoincrement())
  ContractID    Int
  Description   String?
  Amount        Decimal
  DueDate       DateTime
  PaidAmount    Decimal?        @default(0)
  PaidDate      DateTime?
  Status        PaymentStatus   @default(PENDING)
  CreatedAt     DateTime        @default(now())
  Contract      Contract        @relation(fields: [ContractID], references: [ContractID], onDelete: Cascade)

  @@index([ContractID])
  @@index([DueDate])
}

// Phase 2: Document Management
model Document {
  DocumentID   Int            @id @default(autoincrement())
  ContractID   Int?
  ProjectID    Int?
  Name         String
  Type         DocumentType
  URL          String
  Version      Int            @default(1)
  Size         Int?
  MimeType     String?
  UploadedBy   Int
  UploadedAt   DateTime       @default(now())
  UpdatedAt    DateTime       @updatedAt
  Contract     Contract?      @relation(fields: [ContractID], references: [ContractID])
  Project      Project?       @relation(fields: [ProjectID], references: [ProjectID])

  @@index([ContractID])
  @@index([ProjectID])
  @@index([Type])
}

// Phase 3: User Activity Tracking
model UserActivity {
  id          Int      @id @default(autoincrement())
  userId      Int
  action      String
  entityType  String?
  entityId    Int?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([entityType, entityId])
}

// Phase 3: Notifications
model Notification {
  id          Int              @id @default(autoincrement())
  userId      Int
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false)
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())
  expiresAt   DateTime?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// Phase 3: Permissions
model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  module      String
  action      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userPermissions UserPermission[]

  @@index([module])
}

model UserPermission {
  userId       Int
  permissionId Int
  grantedBy    Int?
  grantedAt    DateTime @default(now())
  revokedAt    DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

// Phase 3: Report Templates
model ReportTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  module      String
  config      Json
  isPublic    Boolean  @default(false)
  createdBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creator     User     @relation(fields: [createdBy], references: [id])

  @@index([module])
  @@index([isPublic])
  @@index([createdBy])
}

// Enums for Phase 2
enum EnterpriseType {
  SPRL
  SARL
  SA
  SNC
  SCS
  ONG
  AUTRES
}

enum EnterpriseRole {
  CHEF_FILE
  MEMBRE_GROUPEMENT
  CFEF_CONTRACTANT
  SOUS_TRAITANT
}

enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  COMPLETED
  TERMINATED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum DocumentType {
  PLAN
  CONTRAT
  PV_RECEPTION
  RAPPORT_AVANCEMENT
  FACTURE
  DECOMPTE
  GARANTIE
  AUTRE
}

enum SiteType {
  CENTRE_DE_SANTE
  ECOLE_PRIMAIRE
  BATIMENT_ADMINISTRATIF
}

enum OuvrageType {
  ECOLE
  CENTRE_SANTE
  BATIMENT_ADMINISTRATIF
}

enum ConstructionStepType {
  INSTALLATION_CHANTIER
  FOUILLES
  MACONNERIE_FONDATION
  SOCLES_COLONNES
  REMBLAIS
  SOUS_PAVEMENT
  STRUCTURE_CHARPENTE
  TOITURE
  INSTALLATION_ELECTRIQUE
  INSTALLATION_SANITAIRE
  MENUISERIES
  FINITIONS_INTERIEURES
  FINITIONS_EXTERIEURES
  AMENAGEMENT_ACCES
  CLOTURES
  RECEPTION
}

enum UserRole {
  USER
  ADMIN
  SUPERVISOR
  FINANCE
  CONSTRUCTION
}

enum ApprovalStatus {
  Pending
  Approved
  Rejected
}

enum ApprovalLevel {
  LEVEL_1_RL
  LEVEL_2_RC
  LEVEL_3_CQ
  LEVEL_4_CFEF
}

enum ReconciliationStatus {
  Matched
  Discrepancy
  Pending
  Resolved
}

// Phase 3 Enums
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  TASK_ASSIGNED
  TASK_COMPLETED
  APPROVAL_REQUIRED
  APPROVAL_GRANTED
  APPROVAL_REJECTED
  REPORT_GENERATED
  SYSTEM
}
